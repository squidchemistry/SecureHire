# Copy to .env for local development. Every value has a safe dev default.
ENV=development
DATABASE_URL=sqlite:///./securehire.db
# Production requires 32+ char random values: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
AUDIT_HMAC_KEY=dev-only-audit-key
IDENTITY_HMAC_KEY=dev-only-identity-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# auto = Groq when GROQ_API_KEY is set, otherwise the deterministic (and deliberately gullible) mock
LLM_PROVIDER=auto
GROQ_API_KEY=
# Run the queue worker inside the API process (handy locally and on single-service hosts)
EMBEDDED_WORKER=true
INJECTION_ACTION=flag
